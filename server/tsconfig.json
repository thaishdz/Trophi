{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./build",
    "rootDir": "src",
    "typeRoots": [
      "./node_modules/@types",
      "src/shared/types"
    ],
    // Import alias: "@/services/..." instead of "../../services/...". Also registered for ts-node-dev
    // (-r tsconfig-paths/register in package.json) and Jest (moduleNameMapper in jest.config.js).
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}